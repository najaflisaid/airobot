rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public can READ everything (products, categories, etc.)
    // Any SIGNED-IN user can WRITE (orders, users, and admin-managed data).
    // Admin privileges are enforced in the app via ADMIN_EMAILS.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
